# Copy to .env. Nothing here is required to run the test suite — every LLM
# interaction is replayed from a cassette, so `make test` needs no key.

LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000

# Backend mode: which substrates and adapters serve a request.
# Overridable per request with the X-Backend-Mode header.
BACKEND_MODE_DEFAULT=normal
BACKEND_MODES_ALLOWED=normal,ce-rise

# Models. Overridable per request with the X-Model header.
LLM_MODEL_DEFAULT=gpt-4o-mini
LLM_MODEL_ALLOWED=gpt-4o-mini,gpt-5
OPENAI_API_KEY=

# Cassettes. 'replay' makes no network calls and fails loudly on a cache miss,
# which is what stops a drifted prompt quietly spending money.
# Set to 'record' only when deliberately refreshing them.
LLM_CASSETTE_MODE=replay
LLM_CASSETTE_DIR=tests/cassettes

# Selective decision: the default operating point.
DEFAULT_TAU=0.5
