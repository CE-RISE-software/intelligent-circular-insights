# Copy to `.env` and fill in. `.env` is ignored; this template is not.
#
# apps/api/settings.py is the only module in the codebase that reads the
# environment. Nothing else calls os.getenv, so this file is the whole surface.

# ---------------------------------------------------------------- the model
# Only needed to *record* cassettes or to run live. The test suite, the smoke
# gate and every deterministic feature — retrieval, conformance, both impact
# engines, the graph — run without it.
OPENAI_API_KEY=

# 'replay' (default) never calls the network and fails loudly on a cassette
# miss, which is what makes the suite free to run. 'record' calls the model and
# writes a cassette per request: one deliberate run, then switch back. 'live'
# calls on every request and records nothing.
LLM_CASSETTE_MODE=replay
LLM_CASSETTE_DIR=tests/cassettes

LLM_MODEL_DEFAULT=gpt-4o-mini
LLM_MODEL_ALLOWED=gpt-4o-mini,gpt-5
# Switches off every language-model feature and returns a typed 422 with a
# reason. The rest of the workbench is unaffected.
LLM_DISABLED=false

# ---------------------------------------------------------------- the service
BACKEND_MODE_DEFAULT=normal
BACKEND_MODES_ALLOWED=normal,ce-rise
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO

# The threshold a calibrated confidence must clear before the system answers
# rather than abstains.
DEFAULT_TAU=0.5

# ---------------------------------------------------------------- retrieval
# The context-pack ceiling. Lowering MAX_PASSAGES makes answers cheaper and
# thinner; raising it past what the model can attend to buys nothing and costs
# tokens on every call.
MAX_CONTEXT_CHARS=12000
MAX_PASSAGES=6
